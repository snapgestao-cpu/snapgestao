{
  "expo": {
    "name": "SnapGestão",
    "slug": "snapgestao",
    "scheme": "snapgestao",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#65a7c1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snapgestao.app",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#65a7c1"
      },
      "package": "com.snapgestao.app",
      "versionCode": 31,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAsyncStorageFix",
      "./plugins/withNetworkSecurityConfig",
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "O SnapGestão precisa da câmera para escanear cupons fiscais.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir acesso para salvar relatórios PDF.",
          "savePhotosPermission": "Permitir salvar relatórios PDF.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c46a878a-9c4d-4830-9023-ca3c7a97f83e"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c46a878a-9c4d-4830-9023-ca3c7a97f83e"
    }
  }
}
